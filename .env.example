# =========================================================================
# ZipView 환경 설정 템플릿 (.env.example)
# 복사하여 .env 파일을 생성한 뒤 실제 API 키를 입력하세요.
# =========================================================================

# 1. Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI API Key (GPT-4o)
OPENAI_API_KEY=your_openai_api_key_here

# 3. 국토교통부 공공데이터포털 일반 인증키 (Decoding)
MOLIT_API_KEY=your_molit_api_key_here

# 4. 국토교통부 실거래가 공공 API 엔드포인트
MOLIT_ENDPOINT=https://apis.data.go.kr/1613000/RTMSDataSvcAptTrade/getRTMSDataSvcAptTrade
MOLIT_ENDPOINT_TRADE=https://apis.data.go.kr/1613000/RTMSDataSvcAptTrade/getRTMSDataSvcAptTrade
MOLIT_ENDPOINT_RENT=https://apis.data.go.kr/1613000/RTMSDataSvcAptRent/getRTMSDataSvcAptRent
MOLIT_ENDPOINT_OFFI_RENT=https://apis.data.go.kr/1613000/RTMSDataSvcOffiRent/getRTMSDataSvcOffiRent
MOLIT_ENDPOINT_OFFI_TRADE=https://apis.data.go.kr/1613000/RTMSDataSvcOffiTrade/getRTMSDataSvcOffiTrade
MOLIT_ENDPOINT_RH_RENT=https://apis.data.go.kr/1613000/RTMSDataSvcRHRent/getRTMSDataSvcRHRent
MOLIT_ENDPOINT_RH_TRADE=https://apis.data.go.kr/1613000/RTMSDataSvcRHTrade/getRTMSDataSvcRHTrade
MOLIT_ENDPOINT_SH_RENT=https://apis.data.go.kr/1613000/RTMSDataSvcSHRent/getRTMSDataSvcSHRent
MOLIT_ENDPOINT_SH_TRADE=https://apis.data.go.kr/1613000/RTMSDataSvcSHTrade/getRTMSDataSvcSHTrade

# 서버 포트
PORT=3000

